# Copy to .env and adjust as needed.

# --- Runtime ---
NODE_ENV=production
PORT=3000
# Interface to bind. 0.0.0.0 inside containers; 127.0.0.1 when run directly
# behind a local reverse proxy.
HOST=0.0.0.0

# --- Auth ---
# REQUIRED in production. Generate a strong value: openssl rand -hex 32
JWT_SECRET=change-me-in-production
# JWT token lifetime
JWT_EXPIRES_IN=7d

# --- Initial admin seed ---
# Used only the first time the database is created (when no users exist).
# REQUIRED in production so no weak default credential ships.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Database ---
# SQLite database file location. In Docker this maps to the mounted volume.
DB_PATH=/data/a3shipping.sqlite

# --- CORS (optional) ---
# Comma-separated allow-list of origins for cross-origin API access. Leave
# empty when the frontend is served same-origin (the default).
CORS_ORIGIN=

